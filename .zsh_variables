#Homebrew Variables
export BREW_HOME=/opt/homebrew

# Python Variabls
export PYTHONPATH=/Users/wpnx777/Repos/python

#OpenSSL Variables
export OPENSSL_HOME=${BREW_HOME}/bin/openssl

# Java Variables
export JDK_HOME=${BREW_HOME}/opt/openjdk
export JAVA_HOME=${JDK_HOME}

# GIT Variables
export GIT_HOSTS=(github.com)
export GIT_EMAILS=()
export GIT_SSH_KEYS=()
export GIT_REPO_DIRS=~/Repos

# Personal Variables
export LAST_SETUP_ENV=~/.last-setup-env

# Terminal Variables - Color
export CLICOLOR=1
export GREEN="\033[0;32m"
export RED="\033[0;31m"
export WHITE="\033[0;29m"
export YELLOW="\033[0;33m"

# Terminal Variables - History
export HISTSIZE=10000
export SAVEHIST=10000
export HISTFILE=~/.zshistory
setopt INC_APPEND_HISTORY
setopt HIST_IGNORE_DUPS
setopt EXTENDED_HISTORY

# Terminal Variables - Path
export PATH="${BREW_HOME}/bin:${JDK_HOME}/bin:${OPENSSL_HOME}/bin:${PATH}"

# Terminal Variables - Prompt
set termguicolors
setopt PROMPT_SUBST

autoload -Uz vcs_info
precmd() { vcs_info }
zstyle ':vcs_info:git*' formats '%F{white} : %F{yellow}%b%F{white}'

PROMPT='$(build-prompt)
%F{white}> %f'
