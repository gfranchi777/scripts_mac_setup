# Print Completed or Failed Based On The Last
# Command Exit Status.
function _print-cmd-status {
  if [[ ${?} -eq 0 ]]; then
    echo "✅"
  else
    echo "❌"
  fi
}

# Print A Header Used For CLI Output
# $1 = Header Text
function _print-header {
  local header_char="*"
  local header_cols=65
  local text=" ${1} "
  local text_length=${#text}
  local side_length=$(( (header_cols - text_length) / 2 ))

  echo -n "${YELLOW}"
  
  # Print left side
  for ((i=0; i<side_length; i++)); do
    echo -n "${header_char}"
  done
  
  # Print centered text
  echo -n "${text}"
  
  # Print right side (handle odd numbers with remaining length)
  for ((i=0; i<(header_cols - side_length - text_length); i++)); do
    echo -n "${header_char}"
  done

  echo "${WHITE}\n"
}

# Update / Upgrade Homebrew
function brew-update {
  _print-header "Updating HomeBrew Apps"

  brew update
  brew upgrade
  brew upgrade --cask --greedy
  brew cleanup

  echo ""
}

# Creare The Prompt
function build-prompt {
  if [[ $(whoami) == ${USER_NAME} ]]; then
    local user_name="me"
  else
    local user_name=$(whoami)
  fi

  if [[ $(hostname) == ${HOST_NAME} ]]; then
    local host_name="local"
  else
    local host_name=$(hostname)
  fi

  local day=$(date '+%a %b %d %Y')
  local time=$(date '+%H:%M')

  # Red Prompt
  local left="%F{white}[%F{red}${user_name}%F{white}@%F{red}${host_name}%F{white} : %F{red}%~%F{white}${vcs_info_0_}%F{white}] "
  local right=" [%F{red}${day}%F{white}, %F{red}${time}%F{white}]"

  local rendered_left=$(print -P "${left}")
  local rendered_right=$(print -P "${right}")

  local plain_left=$(echo "${rendered_left}" | sed 's/\x1b\[[0-9;]*m//g')
  local plain_right=$(echo "${rendered_right}" | sed 's/\x1b\[[0-9;]*m//g')

  local total_width=$(tput cols)
  local fill_len=$(( total_width - ${#plain_left} - ${#plain_right} ))

  if [[ ${fill_len} -lt 0 ]]; then
    fill_len=0
  fi

  local fill=$(printf '%*s' ${fill_len} '' | tr ' ' '-')

  print -P "${left}${fill}${right}"
}

# Cache GPG And SSH Keys Used For Bitbucket
function cache-all-keys {
  local host_index=1

  _print-header "Caching Bitbucket Keys"

  eval $(ssh-agent) > /dev/null 2>&1

  for git_host in ${GIT_HOSTS}; do
    #SSH Key Caching
    #Fetch SSH Key Passphrase From Keychain
    echo -n "Caching ${git_host} SSH Key..."
    
    #Cache SSH Key
    ssh-add "${GIT_SSH_KEYS[${host_index}]}" &> /dev/null

    _print-cmd-status
    
    ((host_index++))
  done

  echo ""
}

# Search starting at the current directory for a text pattern inside any files
# in the current directory or it's sub directories
# $1 = Search Pattern
function find-in-files {
  if [[ -z ${1} ]]; then
    echo "[${RED}ERROR${WHITE}] No Search Pattern Passed To Command."
    return 1
  fi

  find . -type f -exec grep -i ${1} '{}' \; -print
}

# Get a random quote from an online api.
function get-online-quote {
  local api_uri="https://zenquotes.io/api/random"
  local status_code=$(curl --write-out %{http_code} --silent --output /dev/null ${api_uri})

  if [[ ${status_code} -eq 200 ]]; then
    echo $(curl -s ${api_uri}) | jq -r '.[] | "\(.q)\n- \(.a)"' | tee -a ~/.quotes
  fi
}

# Get a rancom quote from the ~/.quotes file
function get-local-quote {
  local quote_file=~/.quotes
  local quote_index=$(shuf -i 1-$(sed -n '$=' ${quote_file}) -n 1)

  if [[ $(expr ${quote_index} % 2) -eq 0 ]]; then
    ((quote_index--))
  fi
  
  sed -n "${quote_index}p;$((quote_index + 1))p" ${quote_file} | fold -sw $(echo -n ${PS1} | wc -m)
}

# Automate The Daily Update Tasks
function setup-env {
  cache-all-keys

  brew-update
  
  git-update-branches all
}
